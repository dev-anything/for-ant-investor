# 이 파일을 .env로 복사해서 값을 채운다. 값이 든 .env는 git에 올리지 않는다.
# 배포·배치에서는 같은 이름으로 Vercel 환경변수 / GitHub Secrets에 넣는다.

# 공공데이터포털 (금융위원회 KRX상장종목정보·주식시세정보)
DATA_GO_KR_SERVICE_KEY=

# 금융감독원 DART OpenAPI (본인 키 하나만, 공유 금지)
DART_OPENAPI_KEY=

# Supabase
# URL은 공개돼도 되는 값. 서비스 롤 키는 RLS를 우회하므로 서버·배치에서만 쓴다 (NEXT_PUBLIC_ 금지).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 경제 기사 (F-18, 2차). 네이버 검색 API(NAVER API HUB), 서버에서만 쓴다
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=
